  <diagram name="Page-1" id="KHcn82fUdHFXoBuJhU7F">
    <mxGraphModel dx="1178" dy="718" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="1aIPhiD_bN7p4-epNvI_-68" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#2e75b6;fontColor=#000000;fontSize=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=CMU Serif;" value="&lt;b&gt;manifest.json — MV3&lt;/b&gt;&lt;hr&gt;Host permissions:&lt;br&gt;&amp;nbsp;&amp;nbsp;YouTube · Reddit · X · Twitter&lt;br&gt;&amp;nbsp;&amp;nbsp;hf.space · localhost:8000&lt;br&gt;service_worker: background.js&lt;br&gt;content_scripts:&lt;br&gt;&amp;nbsp;&amp;nbsp;content.js, page-monitor.js&lt;br&gt;web_accessible_resources: assets/" vertex="1">
          <mxGeometry height="200" width="310" x="10" y="20" as="geometry" />
        </mxCell>
        <mxCell id="1aIPhiD_bN7p4-epNvI_-69" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#2e75b6;fontColor=#000000;fontSize=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=CMU Serif;" value="&lt;b&gt;config.js — Selectors &amp;amp; Constants&lt;/b&gt;&lt;hr&gt;YouTube: ytd-comment-thread-renderer&lt;br&gt;Reddit: shreddit-comment&lt;br&gt;X/Twitter: article[data-testid]&lt;br&gt;Manual batch: 30 · Passive sample: 24&lt;br&gt;Debounce: 1400 ms&lt;br&gt;Shield threshold: 0.62&lt;br&gt;Timeouts: Local 60s / Cloud 120s" vertex="1">
          <mxGeometry height="200" width="310" x="330" y="20" as="geometry" />
        </mxCell>
        <mxCell id="1aIPhiD_bN7p4-epNvI_-70" parent="1" style="shape=mxgraph.cisco.servers.standard_server;whiteSpace=wrap;html=1;fillColor=#fff9db;strokeColor=#d6b656;fontColor=#4a3800;fontSize=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;rounded=1;fontFamily=CMU Serif;" value="&lt;b&gt;chrome.storage.local&lt;/b&gt;&lt;hr&gt;&lt;br&gt;Current mode (Cloud / Local)&lt;br&gt;Shield threshold value&lt;br&gt;User preferences&lt;br&gt;&lt;br&gt;(read/write by all modules)" vertex="1">
          <mxGeometry height="180" width="231" x="669" y="70" as="geometry" />
        </mxCell>
        <mxCell id="1aIPhiD_bN7p4-epNvI_-71" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=CMU Serif;" value="&lt;b&gt;background.js — MV3 Service Worker&lt;/b&gt;&lt;hr&gt;chrome.tabs.onActivated / onUpdated / onRemoved&lt;br&gt;Tracks per-tab session start time&lt;br&gt;Discards sessions under 10 seconds&lt;br&gt;On valid session end:&lt;br&gt;&amp;nbsp;&amp;nbsp;POST /api/events (Local Mode only)&lt;br&gt;Reads mode from chrome.storage.local" vertex="1">
          <mxGeometry height="210" width="430" x="84" y="330" as="geometry" />
        </mxCell>
        <mxCell id="1aIPhiD_bN7p4-epNvI_-72" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9db;strokeColor=#d6b656;fontColor=#4a3800;fontSize=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=CMU Serif;" value="&lt;b&gt;Mode Manager — Routing Logic&lt;/b&gt;&lt;hr&gt;Cloud Mode (default):&lt;br&gt;&amp;nbsp;&amp;nbsp;Route to hf.space/batch · Timeout: 120s&lt;br&gt;Local Mode (opt-in):&lt;br&gt;&amp;nbsp;&amp;nbsp;GET /health (health check first)&lt;br&gt;&amp;nbsp;&amp;nbsp;Fail → fallback Cloud + warn user&lt;br&gt;&amp;nbsp;&amp;nbsp;Route to localhost:8000/api/analyze&lt;br&gt;&amp;nbsp;&amp;nbsp;Timeout: 60s&lt;br&gt;Mode persisted in chrome.storage.local" vertex="1">
          <mxGeometry height="210" width="326" x="554" y="350" as="geometry" />
        </mxCell>
        <mxCell id="1aIPhiD_bN7p4-epNvI_-73" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=CMU Serif;" value="&lt;b&gt;content.js — Manual Comment Extraction&lt;/b&gt;&lt;hr&gt;Triggered by &quot;Analyse Thread&quot; button&lt;br&gt;Reads platform selectors from config.js&lt;br&gt;querySelectorAll → collect visible comment nodes&lt;br&gt;Extracts innerText · deduplicates entries&lt;br&gt;Truncates each comment to 512 tokens&lt;br&gt;Splits into batches of 30&lt;br&gt;Sends each batch → Mode Manager → API&lt;br&gt;Returns label distributions to popup.js" vertex="1">
          <mxGeometry height="250" width="430" x="84" y="600" as="geometry" />
        </mxCell>
        <mxCell id="1aIPhiD_bN7p4-epNvI_-74" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=CMU Serif;" value="&lt;b&gt;page-monitor.js — Passive Monitoring&lt;/b&gt;&lt;hr&gt;MutationObserver on document.body&lt;br&gt;1400 ms debounce (avoids scroll spam)&lt;br&gt;Samples up to 24 new visible comments/cycle&lt;br&gt;Skips already-processed nodes (session Set)&lt;br&gt;Sends sample → Mode Manager → API&lt;br&gt;Applies Smart Shield blur if risk ≥ 0.62&lt;br&gt;Tracks rolling session risk average&lt;br&gt;Injects rabbit-hole nudge if avg risk &amp;gt; 0.40&lt;br&gt;Manages 5-min breather mode overlay&lt;br&gt;Watches textarea for draft support prompts" vertex="1">
          <mxGeometry height="250" width="356" x="554" y="600" as="geometry" />
        </mxCell>
        <mxCell id="1aIPhiD_bN7p4-epNvI_-75" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=CMU Serif;" value="&lt;b&gt;Popup UI — popup.html + popup.js  [3 Tabs]&lt;/b&gt;&lt;hr&gt;Tab 1 — Dashboard:&lt;br&gt;&amp;nbsp;&amp;nbsp;Chart.js doughnut (label distribution)&lt;br&gt;&amp;nbsp;&amp;nbsp;Risk band summary · session count&lt;br&gt;Tab 2 — Thread Analysis:&lt;br&gt;&amp;nbsp;&amp;nbsp;Per-comment risk score + top label&lt;br&gt;&amp;nbsp;&amp;nbsp;Label filter dropdown&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;Analyse Thread&quot; → triggers content.js&lt;br&gt;Tab 3 — Settings:&lt;br&gt;&amp;nbsp;&amp;nbsp;Cloud/Local mode toggle&lt;br&gt;&amp;nbsp;&amp;nbsp;Shield threshold slider (default 0.62)&lt;br&gt;&amp;nbsp;&amp;nbsp;Health status · privacy disclosure" vertex="1">
          <mxGeometry height="310" width="406" x="84" y="920" as="geometry" />
        </mxCell>
        <mxCell id="1aIPhiD_bN7p4-epNvI_-76" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=CMU Serif;" value="&lt;b&gt;Wellbeing Interventions&amp;nbsp;&lt;/b&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp;(injected by page-monitor.js)&lt;/b&gt;&lt;hr&gt;🛡 Smart Shield:&lt;br&gt;&amp;nbsp;&amp;nbsp;CSS blur on risk ≥ 0.62 · click-to-reveal&lt;br&gt;🐇 Rabbit-Hole Nudge:&lt;br&gt;&amp;nbsp;&amp;nbsp;Fixed-position div · avg risk &amp;gt; 0.40&lt;br&gt;&amp;nbsp;&amp;nbsp;Fully dismissable without action&lt;br&gt;🌬 Breather Mode:&lt;br&gt;&amp;nbsp;&amp;nbsp;Full-page overlay · 5-min countdown&lt;br&gt;&amp;nbsp;&amp;nbsp;Early dismiss always available&lt;br&gt;✍ Draft Support Prompts:&lt;br&gt;&amp;nbsp;&amp;nbsp;Keyword match in textarea / contenteditable&lt;br&gt;&amp;nbsp;&amp;nbsp;Locale helpline: iCall · Vandrevala (India)&lt;br&gt;&amp;nbsp;&amp;nbsp;Does NOT intercept typed content&lt;/div&gt;" vertex="1">
          <mxGeometry height="310" width="356" x="554" y="920" as="geometry" />
        </mxCell>
        <mxCell id="1aIPhiD_bN7p4-epNvI_-77" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#888888;fontColor=#333333;fontSize=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=CMU Serif;" value="&lt;b&gt;content.css — Overlay Styles&lt;/b&gt;&lt;hr&gt;Blur filter CSS for Smart Shield&lt;br&gt;Nudge div layout and positioning&lt;br&gt;Breather mode full-page overlay&lt;br&gt;Draft helpline panel styling" vertex="1">
          <mxGeometry height="150" width="390" x="84" y="1300" as="geometry" />
        </mxCell>
        <mxCell id="1aIPhiD_bN7p4-epNvI_-78" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#888888;fontColor=#333333;fontSize=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=CMU Serif;" value="&lt;b&gt;Chart.js  (bundled local — no CDN)&lt;/b&gt;&lt;hr&gt;MV3 CSP compliant · no remote fetch&lt;br&gt;Local copy stored in extension assets/&lt;br&gt;Used exclusively by popup.js&lt;br&gt;Renders doughnut chart in Dashboard tab" vertex="1">
          <mxGeometry height="150" width="390" x="554" y="1300" as="geometry" />
        </mxCell>
